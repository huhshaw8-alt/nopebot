[Unit]
Description=SMS gateway telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=smsbot
Group=smsbot
WorkingDirectory=/opt/smsbot
ExecStart=/opt/smsbot/venv/bin/python -u /opt/smsbot/bot.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
